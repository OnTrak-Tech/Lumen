{
  "name": "lumen",
  "version": "0.1.0",
  "description": "Real-time Bible verse display for live sermons, integrated with OBS Studio",
  "main": "dist/electron/main.js",
  "type": "module",
  "scripts": {
    "dev:server": "tsx src/overlay/server.ts",
    "dev:vite": "vite",
    "dev": "concurrently \"npm run dev:server\" \"npm run dev:vite\"",
    "dev:electron": "concurrently \"npm run dev:server\" \"npm run dev:vite\" \"wait-on http://localhost:5173 && tsc -p tsconfig.electron.json && electron dist/electron/main.js\"",
    "build:renderer": "vite build",
    "build:electron": "tsc -p tsconfig.electron.json",
    "build:server": "esbuild src/overlay/server.ts --bundle --platform=node --format=esm --outfile=dist/server/server.js --external:electron",
    "build": "npm run build:renderer && npm run build:electron && npm run build:server",
    "dist": "npm run build && electron-builder",
    "dist:win": "npm run build && electron-builder --win",
    "dist:mac": "npm run build && electron-builder --mac",
    "dist:linux": "npm run build && electron-builder --linux",
    "test:detector": "tsx test/test-detector.ts"
  },
  "keywords": [
    "bible",
    "obs",
    "speech-recognition",
    "church",
    "livestream"
  ],
  "author": "",
  "license": "MIT",
  "dependencies": {
    "@deepgram/sdk": "^3.9.0",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.21.1",
    "lucide-react": "^0.460.0",
    "obs-websocket-js": "^5.0.6",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "ws": "^8.18.0"
  },
  "devDependencies": {
    "@electron/rebuild": "^4.2.1",
    "@types/cors": "^2.8.17",
    "@types/express": "^5.0.0",
    "@types/node": "^22.9.0",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@types/ws": "^8.5.13",
    "@vitejs/plugin-react": "^4.3.3",
    "autoprefixer": "^10.4.20",
    "concurrently": "^9.1.0",
    "electron": "^45.4.1",
    "electron-builder": "^26.18.0",
    "electron-builder-squirrel-windows": "^26.18.0",
    "postcss": "^8.4.49",
    "tailwindcss": "^3.4.15",
    "tsx": "^4.19.2",
    "typescript": "^5.6.3",
    "vite": "^5.4.11"
  },
  "build": {
    "appId": "com.lumen.stageled",
    "productName": "Lumen",
    "copyright": "Copyright © 2024",
    "files": [
      "dist/**/*",
      "node_modules/**/*"
    ],
    "extraResources": [
      {
        "from": "dist/server",
        "to": "server"
      },
      {
        "from": "src/overlay/public",
        "to": "public"
      }
    ],
    "win": {
      "target": "nsis",
      "icon": "assets/icon.ico"
    },
    "mac": {
      "target": "dmg",
      "icon": "assets/icon.icns",
      "category": "public.app-category.utilities"
    },
    "linux": {
      "target": "AppImage",
      "icon": "assets/icon.png",
      "category": "AudioVideo"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true
    },
    "publish": {
      "provider": "github",
      "releaseType": "release"
    }
  }
}
